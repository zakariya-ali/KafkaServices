# Copy to `.env` (same folder as docker-compose.yml) to override defaults.
# Docker Compose reads `.env` automatically.

# Host ports
PRODUCER_PORT=8081
CONSUMER_PORT=8082
# Port your IntelliJ-run services use to reach Kafka (EXTERNAL listener)
KAFKA_EXTERNAL_PORT=29092

# Kafka topic / consumer group used by the services
ORDER_TOPIC=order-events
CONSUMER_GROUP_ID=order-processing-group
